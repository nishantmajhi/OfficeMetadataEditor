<ui:FluentWindow
    x:Class="OfficeMetadataEditor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:conv="clr-namespace:OfficeMetadataEditor.Converters"
    xmlns:vm="clr-namespace:OfficeMetadataEditor.ViewModels"
    Title="Office Metadata Editor"
    Icon="pack://application:,,,/Assets/app.ico"
    Width="780" Height="560"
    MinWidth="620" MinHeight="440"
    WindowBackdropType="Mica"
    ExtendsContentIntoTitleBar="True"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:FileTypeToBadgeTextConverter x:Key="BadgeTextConverter" />
        <conv:FileTypeToAccentBrushConverter x:Key="AccentBrushConverter" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:StatusLevelToBrushConverter x:Key="StatusBrushConverter" />
        <conv:DirtyToCloseLabelConverter x:Key="CloseLabelConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- Titlebar -->
            <RowDefinition Height="Auto" />   <!-- Menu -->
            <RowDefinition Height="*" />      <!-- Content -->
            <RowDefinition Height="Auto" />   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- Titlebar -->
        <ui:TitleBar
            Grid.Row="0"
            Title="Office Metadata Editor">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Menu bar -->
        <Border Grid.Row="1" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <Menu Padding="4" Background="Transparent">
                <MenuItem Header="_File">
                    <MenuItem Header="Open document…" InputGestureText="Ctrl+O" Click="OnOpenClick" />
                    <MenuItem Header="Open recent" SubmenuOpened="OnOpenRecentSubmenuOpened">
                        <MenuItem Header="(placeholder)" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Exit" Click="OnExitClick" />
                </MenuItem>
                <MenuItem Header="_Help">
                    <MenuItem Header="About This App" Click="OnAboutClick" />
                </MenuItem>
            </Menu>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="2">

            <!-- Empty state -->
            <StackPanel
                Visibility="{Binding IsDocumentLoaded, Converter={StaticResource InverseBoolToVis}}"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                MaxWidth="360" TextElement.FontSize="13">
                <Border Width="56" Height="56" CornerRadius="12" BorderThickness="1.5"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        HorizontalAlignment="Center" Margin="0,0,0,14">
                    <ui:SymbolIcon Symbol="DocumentSearch24" FontSize="22"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Border>
                <TextBlock Text="No document open" FontSize="15" FontWeight="Medium"
                           HorizontalAlignment="Center" Margin="0,0,0,6" />
                <TextBlock TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4">
                    Click <Run FontWeight="Medium">File → Open document…</Run> to select a Word, Excel, or PowerPoint file and edit its metadata.
                </TextBlock>
                <TextBlock Text=".docx | .xlsx | .pptx" FontFamily="Consolas"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,14" />
                <ui:Button Content="Open document…" Appearance="Secondary"
                           HorizontalAlignment="Center" Click="OnOpenClick" />
            </StackPanel>

            <!-- Loaded state -->
            <Grid Visibility="{Binding IsDocumentLoaded, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- File header -->
                    <RowDefinition Height="*" />    <!-- Form -->
                    <RowDefinition Height="Auto" /> <!-- Actions -->
                </Grid.RowDefinitions>

                <!-- File header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="24,16,24,14">
                    <Border Width="32" Height="32" CornerRadius="6"
                            Background="{Binding FileType, Converter={StaticResource AccentBrushConverter}}">
                        <TextBlock Text="{Binding FileType, Converter={StaticResource BadgeTextConverter}}"
                                   Foreground="White" FontWeight="Bold" FontFamily="Consolas"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileName}" FontWeight="Medium" FontSize="14" />
                        <TextBlock Text="{Binding FileDirectory}" FontFamily="Consolas" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Editable fields -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="24,10,24,10" MaxWidth="640" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Author" Margin="0,8,12,14"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <ui:TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,14"
                                    Text="{Binding Author, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Last modified by" Margin="0,8,12,14"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <ui:TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,14"
                                    Text="{Binding LastModifiedBy, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Revision number" Margin="0,8,12,14"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <ui:TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,14" FontFamily="Consolas"
                                    Text="{Binding Revision, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,8,12,14">
                            <TextBlock Text="Created" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Date and time" FontSize="10.5"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,14">
                            <DatePicker SelectedDate="{Binding CreatedDate}" Width="260" />
                            <ui:TextBox Margin="8,0,0,0" Width="116" FontFamily="Consolas"
                                        Text="{Binding CreatedTime, UpdateSourceTrigger=PropertyChanged, StringFormat=hh\\:mm\\:ss}" />
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,8,12,14">
                            <TextBlock Text="Last modified" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Date and time" FontSize="10.5"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,14">
                            <DatePicker SelectedDate="{Binding ModifiedDate}" Width="260" />
                            <ui:TextBox Margin="8,0,0,0" Width="116" FontFamily="Consolas"
                                        Text="{Binding ModifiedTime, UpdateSourceTrigger=PropertyChanged, StringFormat=hh\\:mm\\:ss}" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Actions -->
                <StackPanel Grid.Row="2" Margin="24,12,24,16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="{Binding IsDirty, Converter={StaticResource CloseLabelConverter}}"
                                   Appearance="Secondary" Margin="0,0,10,0" Click="OnCloseClick" />
                        <ui:Button Content="Save changes"
                                   Background="{Binding FileType, Converter={StaticResource AccentBrushConverter}}"
                                   Foreground="White"
                                   BorderThickness="0"
                                   IsEnabled="{Binding IsSaveEnabled}"
                                   Click="OnSaveClick" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                Padding="14,5">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Fill="{Binding StatusLevel, Converter={StaticResource StatusBrushConverter}}"
                          Margin="0,0,7,0" />
                <TextBlock Text="{Binding StatusText}" FontSize="11"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
